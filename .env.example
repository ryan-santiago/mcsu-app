# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Neon Postgres connection string.
# Neon Console -> your project -> Connect -> "Connection string" (pooled).
# Must include ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/mcsu?sslmode=require"

# Signs session cookies. Generate one with:
#   npx @better-auth/cli@latest secret
# Use a DIFFERENT value in production than in development.
BETTER_AUTH_SECRET="replace-me-with-a-32-plus-character-random-string"

# Port `next dev` / `next start` listen on. Optional — Next.js defaults to
# 3000 if omitted. Pick something NOT already in use on your machine — in
# particular, avoid 5432, which is Postgres's standard port and is often
# already bound locally even though this app talks to Neon, not a local DB.
PORT=4000

# The canonical origin of this deployment. Auth callbacks are built from it.
# Local:      http://localhost:4000  (or whatever PORT above is set to)
# Production: https://your-app.vercel.app  (or your custom domain — PORT is
#             irrelevant on Vercel, which fronts the app on 443 regardless)
BETTER_AUTH_URL="http://localhost:4000"

# Optional — Entra ID app registration (Microsoft Graph, app-only client
# credentials). Shared by both integrations below. Leave unset to run
# without either; both degrade quietly. See docs/DOCUMENTS.md and
# docs/EMPLOYEE_RECOMMENDATION.md §13 for the IT ask (Sites.Selected +
# Mail.Send application permissions on this one app).
# AZURE_TENANT_ID=""
# AZURE_CLIENT_ID=""
# AZURE_CLIENT_SECRET=""

# Optional — email notifications (Employee Recommendation approvals/
# rejections, password reset, etc). Requires AZURE_* above plus Mail.Send.
# MS_SENDER_EMAIL=""
# MS_TEST_RECIPIENT=""

# Optional — while NOT in production, redirects every outbound email to this
# one address instead of its real recipients, so coworkers don't get spammed
# by test submissions/approvals/rejections that use real employee emails to
# simulate the workflow. Set in every non-prod environment; leave unset ONLY
# in production. This is the entire dev/prod switch — no code change needed.
# EMAIL_OVERRIDE_TO=""

# Optional — SharePoint site for One-Lot Project Docs storage. Requires
# AZURE_* above plus Sites.Selected (granted per-site). Either set
# SHAREPOINT_SITE_ID directly, or set hostname + path to resolve it via Graph.
# SHAREPOINT_SITE_ID=""
# SHAREPOINT_SITE_HOSTNAME=""
# SHAREPOINT_SITE_PATH=""
# SHAREPOINT_DRIVE_NAME="Documents"
