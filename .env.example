# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Neon Postgres connection string.
# Neon Console -> your project -> Connect -> "Connection string" (pooled).
# Must include ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/mcsu?sslmode=require"

# Signs session cookies. Generate one with:
#   npx @better-auth/cli@latest secret
# Use a DIFFERENT value in production than in development.
BETTER_AUTH_SECRET="replace-me-with-a-32-plus-character-random-string"

# Port `next dev` / `next start` listen on. Optional — Next.js defaults to
# 3000 if omitted. Pick something NOT already in use on your machine — in
# particular, avoid 5432, which is Postgres's standard port and is often
# already bound locally even though this app talks to Neon, not a local DB.
PORT=4000

# The canonical origin of this deployment. Auth callbacks are built from it.
# Local:      http://localhost:4000  (or whatever PORT above is set to)
# Production: https://your-app.vercel.app  (or your custom domain — PORT is
#             irrelevant on Vercel, which fronts the app on 443 regardless)
BETTER_AUTH_URL="http://localhost:4000"
