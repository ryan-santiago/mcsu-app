# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template every clone copies from — see docs/SETUP.md
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local screenshots from scripts/screenshot.mjs
/.screenshots

# data snapshot from scripts/backup-data.ts — contains employee PII
# (mobile numbers, personal emails, home addresses), never commit it
/scripts/seed-data

# One-Lot Project Docs — uploaded files, local-disk stand-in until
# SharePoint integration (see docs/DOCUMENTS.md). Never commit real uploads.
/storage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# editor
.vscode/
.idea/

# windows
Thumbs.db
desktop.ini
